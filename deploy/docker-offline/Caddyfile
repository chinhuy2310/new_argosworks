{
    admin off
}

# {$DOMAIN:localhost}
# - Nếu DOMAIN là tên miền công khai (ví dụ: argos.yourcompany.com), Caddy TỰ ĐỘNG cấp chứng chỉ Let's Encrypt / ZeroSSL hợp lệ.
# - Nếu DOMAIN là localhost hoặc IP nội bộ, Caddy tự động kích hoạt TLS nội bộ (internal CA).
# - Để ghi đè cấu hình TLS (ví dụ tự ký): đặt biến TLS_DIRECTIVE="tls internal".
{$DOMAIN:localhost} {
    {$TLS_DIRECTIVE}

    reverse_proxy argos-works:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }

    encode gzip zstd

    # Enterprise Hardened Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self';"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
