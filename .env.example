# ==============================================================================
# ARGOS WORKS ENTERPRISE - Environment Configuration Template
# Sao chép file này thành .env và cấu hình các giá trị phù hợp với hạ tầng doanh nghiệp.
# Không bao giờ commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# 1. Mạng & Tên miền (Domain & Reverse Proxy)
# ------------------------------------------------------------------------------
# Tên miền chính thức của Doanh nghiệp (Ví dụ: argos.company.com)
# - Nếu là tên miền thật trỏ về máy chủ: Caddy tự động cấp phát SSL Let's Encrypt hợp lệ.
# - Nếu để localhost hoặc IP nội bộ (LAN): Caddy tự động phát hành Internal TLS chứng chỉ tự ký.
DOMAIN=localhost

# Cổng dịch vụ bên ngoài (Reverse Proxy / HTTPS)
HTTP_PORT=80
HTTPS_PORT=443

# Cổng ứng dụng backend ARGOS (nội bộ)
ARGOS_PORT=8080

# Múi giờ hệ thống
TZ=Asia/Seoul

# Cấu hình Cơ sở dữ liệu Doanh nghiệp (PostgreSQL / SQLite)
# - Để trống nếu muốn chạy SQLite file local (zero-infra)
# - Hoặc cấu hình DSN PostgreSQL để chạy chế độ Enterprise Multi-tenant
# LƯU Ý: Phải đặt mật khẩu mạnh (bắt buộc đối với Docker Compose)
DATABASE_URL=postgresql://argos_admin:YOUR_STRONG_PASSWORD_HERE@localhost:5432/argos_works
POSTGRES_DB=argos_works
POSTGRES_USER=argos_admin
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# 2. Bảo mật & Xác thực (Security & Authentication)
# ------------------------------------------------------------------------------
# Khóa Master bắt buộc cho mã hóa bí mật doanh nghiệp (AES-256 Authenticated Encryption)
# BẮT BUỘC ĐẶT: Khóa 64 ký tự hex (32 bytes) hoặc chuỗi ngẫu nhiên có độ dài tối thiểu 32 ký tự.
# Có thể sinh bằng: openssl rand -hex 32
ARGOS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# (선택) 라이선스 공개키 교체가 필요한 경우에만 사용. 기본값은 서버 코드에 내장된
# 공급사 공개키이며, 개인키(서명키)는 절대 고객사 환경에 두지 않습니다.
# ARGOS_LICENSE_PUBLIC_KEY=
# Cho phép nhân viên tự do đăng ký tài khoản (true / false)
# - false (MẶC ĐỊNH): Tắt đăng ký tự do. Chỉ Admin mới có quyền tạo hoặc phê duyệt tài khoản.
# - true: Chỉ dùng cho môi trường nội bộ thử nghiệm hoặc demo có kiểm soát.
ALLOW_PUBLIC_REGISTER=false

# Thời gian sống của phiên đăng nhập (tính bằng Giờ, mặc định: 24h)
SESSION_TTL_HOURS=24

# Danh sách reverse proxy tin cậy (IP hoặc CIDR, phân tách bằng dấu phẩy).
# ARGOS chỉ đọc header X-Forwarded-For / X-Real-IP khi kết nối TCP trực tiếp
# đến từ một địa chỉ trong danh sách này — nhờ vậy máy trạm trong LAN không thể
# giả mạo IP để vượt rate-limit hoặc làm sai lệch audit log.
# - Docker Compose mặc định: 127.0.0.1,::1,172.16.0.0/12 (dải bridge của Docker)
# - Nếu Caddy/proxy chạy ở subnet khác (ví dụ 10.0.5.0/24), bổ sung vào đây:
#   TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.5.0/24
# - "0.0.0.0" = tin cậy mọi peer (KHÔNG dùng cho production).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12


# 3. Sao lưu & Phục hồi CSDL (Backup & Disaster Recovery)
# ------------------------------------------------------------------------------
# Thư mục lưu trữ sao lưu CSDL tùy chọn (Để trống sẽ mặc định dùng ./data/backups)
# Có thể trỏ tới ổ đĩa phụ, thư mục chia sẻ mạng NAS hoặc thư mục đồng bộ Google Drive / OneDrive
# Ví dụ Windows: D:/ArgosBackups hoặc //nas-storage/backups
# Ví dụ Linux: /mnt/nas/backups
BACKUP_DIR=


# 4. Tích hợp AI / LLM (Tùy chọn - Chỉ cấu hình khi sử dụng trợ lý AI RAG)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Khuyến nghị cho Semantic Search & Chat RAG)
GEMINI_API_KEY=

# OpenAI API Key (Tùy chọn nếu dùng OpenAI GPT-4o / Text-Embedding-3)
OPENAI_API_KEY=

# Anthropic Claude API Key (Tùy chọn)
ANTHROPIC_API_KEY=

# Ollama Endpoint (Dành cho doanh nghiệp chạy LLM 100% Offline / Air-gapped)
# Ví dụ: http://localhost:11434
OLLAMA_BASE_URL=


# 5. Tích hợp Jira Cloud (Tùy chọn - Để trống nếu không liên kết Jira)
# ------------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
