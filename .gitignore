# ==============================================================================
# ARGOS WORKS — Git Ignore Specification
# ==============================================================================

# Environment files & Secrets
.env
.env.local
.env.*.local
.csrf_secret
data/.csrf_secret
server/config.json
config.json

# SQLite Databases & Dynamic Production Data
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/backups/
data/attachments/
data/products/
data/chat_history/
data/reports/
data/test_*

# Logs & Temporary Files
logs/
*.log
*.tmp
*.tmp.*
scratch/
filelist.txt
dist/

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Vendor-only license signing key & issuance log (NEVER commit)
tools/vendor/license_signing_key.hex
tools/vendor/issued_licenses.csv

# Test & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# OS-Specific Files
Thumbs.db
Desktop.ini
.DS_Store

# Local-only documents, specifications, checklists & presentations
# Delivery/legal markdown MUST be versioned (EULA, deployment, guides), so
# docs/*.md is whitelisted; binaries/presentations stay local.
docs/*
!docs/*.md
!docs/images/.gitkeep
docs/images/
.env.bak*
temp_env.txt

# Local design concepts & previews (not required for runtime)
web/images/
web/logo-preview.html


# GitHub Actions workflows are versioned with the code: if CI is not committed,
# it never runs, and every quality gate silently disappears.
# (.github/ used to be ignored here — do not re-add it.)

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
